GROQ_API_KEY=xxxxxxxx
GOOGLE_API_KEY=xxxxxxxx
HF_TOKEN=xxxxxxxx

# Bulk extraction: Gemini free tier (15 RPM measured), Groq as fallback (8,000 TPM)
EXTRACT_MODEL=gemini-3.1-flash-lite
EXTRACT_FALLBACK_MODEL=gemini-3.5-flash-lite,openai/gpt-oss-20b
EXTRACT_RPM=12

# Answers + brief: few tokens per call, fits Groq's cap
ANSWER_MODEL=openai/gpt-oss-120b

# Embeddings: local = sentence-transformers on CPU (no quota). gemini = API (100 texts/min free)
EMBED_PROVIDER=local
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
